  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:particulateMatter .

_:genid12
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:photochemicalOzoneFormationHumanHealth .

_:genid16
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:climateChangeTotal .

_:genid20
  a owl:Restriction ;
  owl:onProperty ns1:hasFlowType ;
  owl:someValuesFrom ns1:EnergyFlow .

_:genid24
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:someValuesFrom [
    a owl:Restriction ;
    owl:onProperty ns1:hasImpactType ;
    owl:hasValue ns1:environmentalImpact
  ] .

_:genid29
  a owl:Class ;
