  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:eutrophicationMarine .

_:genid35
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:eutrophicationTerrestial .

_:genid39
  a owl:Restriction ;
  owl:onProperty ns1:hasFlowType ;
  owl:someValuesFrom ns1:FlowType .

_:genid43
  a owl:Restriction ;
  owl:onProperty ns1:hasFlowType ;
  owl:hasValue ns1:fossil .

_:genid47
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:someValuesFrom ns1:ImpactCategory .

_:genid51
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:landUseOccupationAndTransformation .

_:genid55
  a owl:Restriction ;
  owl:onProperty ns1:hasFlowType ;
  owl:hasValue ns1:material .

_:genid59
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:ozoneDepletion .

_:genid63
  a owl:Class ;
  owl:unionOf (
   _:genid65
   _:genid67
   _:genid69
 ) .

_:genid65
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:ecotoxicityFreshwater .

_:genid67
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:humanToxicityCancer .

_:genid69
  a owl:Restriction ;
  owl:onProperty ns1:hasImpactCategory ;
  owl:hasValue ns1:humanToxicityNonCancer .

_:genid73
  a owl:Restriction ;
  owl:onProperty ns1:hasFlowType ;
  owl:hasValue ns1:water .

[]
  a <http://www.w3.org/2003/11/swrl#Imp> ;
  ns2:body (
   _:genid77
   _:genid79
   _:genid81
   _:genid83
   _:genid85
   _:genid87
 ) ;
  ns2:head ( _:genid89 ) .

_:genid77
  a ns2:ClassAtom ;
  ns2:classPredicate ns1:LcaResult ;
  ns2:argument1 <urn:swrl:var#r> .

_:genid79
  a ns2:IndividualPropertyAtom ;
  ns2:propertyPredicate ns1:isAssessedByICI ;
  ns2:argument1 <urn:swrl:var#c> ;
  ns2:argument2 <urn:swrl:var#i> .

_:genid81
