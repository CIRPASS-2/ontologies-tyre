  ns2:argument1 <urn:swrl:var#i> ;
  ns2:argument2 <urn:swrl:var#u> .

_:genid85
  a ns2:IndividualPropertyAtom ;
  ns2:propertyPredicate ns1:hasImpactCategory ;
  ns2:argument1 <urn:swrl:var#r> ;
  ns2:argument2 <urn:swrl:var#c> .

_:genid87
  a ns2:ClassAtom ;
  ns2:classPredicate ns1:ImpactCategory ;
  ns2:argument1 <urn:swrl:var#c> .

_:genid89
